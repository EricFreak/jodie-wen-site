---
import { getCollection } from 'astro:content';
import PublicationList from '../components/PublicationList.astro';
import BaseLayout from '../components/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import VideoCard from '../components/VideoCard.astro';
import Gallery from '../components/Gallery.astro';
import { ui } from '../i18n/ui';
import { localizePath } from '../i18n/utils';

const locale = 'en' as const;
const t = ui[locale];
const latest = (await getCollection('publications'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
// 首页视频卡片：featured 优先，其余按日期倒序，取前 3 条
const videos = (await getCollection('media'))
  .filter((e) => e.data.type === 'video')
  .sort((a, b) => Number(b.data.featured ?? false) - Number(a.data.featured ?? false) || b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const photos = (await getCollection('gallery'))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
---
<BaseLayout title="Jodie Wen — CISS Fellow, Tsinghua University" locale={locale} description={t['hero.tagline']}>
  <Hero locale={locale} />

  <section class="mt-14">
    <SectionHeader title={t['home.book.title']} />
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center">
      <input type="checkbox" id="cover-zoom" class="peer sr-only" />
      <label for="cover-zoom" class="w-fit shrink-0 cursor-zoom-in rounded-md peer-focus-visible:ring-2 peer-focus-visible:ring-accent">
        <img src="/images/book-cover.jpg" alt="Cover of Research on the Middle East Policy of the United States (2009–2017)" class="h-72 w-auto rounded-md" />
      </label>
      <div>
        <h3 class="font-serif text-xl font-semibold">Research on the Middle East Policy of the United States (2009–2017)</h3>
        <p class="mt-1 text-sm text-neutral-500">《美国的中东政策研究（2009-2017）》 · January 2026</p>
        <p class="measure mt-3 text-neutral-700">A systematic study of U.S. policy toward the Middle East from 2009 to 2017, drawing on Dr. Wen's research and field experience in the region.</p>
        <a href={localizePath('/book', locale)} class="mt-3 inline-block text-sm font-medium text-accent hover:underline">{t['home.viewAll']}</a>
      </div>
      <label for="cover-zoom" class="fixed inset-0 z-50 hidden cursor-zoom-out items-center justify-center bg-neutral-900/70 p-6 peer-checked:flex">
        <img src="/images/book-cover.jpg" alt="Cover of Research on the Middle East Policy of the United States (2009–2017), enlarged" class="max-h-[90vh] max-w-full rounded-md object-contain" />
      </label>
    </div>
  </section>

  <section class="mt-14">
    <SectionHeader title={t['home.publications.title']} />
    <PublicationList entries={latest} locale={locale} />
    <a href={localizePath('/publications', locale)} class="text-sm font-medium text-accent hover:underline">{t['home.viewAll']}</a>
  </section>

  <section class="mt-14">
    <SectionHeader title={t['home.media.title']} />
    {videos.length > 0 && (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {videos.map((v) => <VideoCard entry={v} locale={locale} />)}
      </div>
    )}
    <a href={localizePath('/media', locale)} class="mt-4 inline-block text-sm font-medium text-accent hover:underline">{t['home.viewAll']}</a>
  </section>

  <section class="mt-14">
    <SectionHeader title={t['home.moreAbout']} />
    {photos.length === 0
      ? <p class="text-neutral-500">{t['empty']}</p>
      : <Gallery entries={photos} locale={locale} />}
  </section>
</BaseLayout>
