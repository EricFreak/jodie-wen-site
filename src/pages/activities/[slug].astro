---
import type { CollectionEntry } from 'astro:content';
import ArticleDetail from '../../components/ArticleDetail.astro';
import { getArticlePaths } from '../../lib/articles';

const locale = 'en' as const;
export async function getStaticPaths() {
  return getArticlePaths('activities', 'en');
}
const { entry, body } = Astro.props as {
  entry: CollectionEntry<'activities'>;
  body: CollectionEntry<'articleBodies'>;
};
---
<ArticleDetail entry={entry} body={body} section="activities" locale={locale} />
