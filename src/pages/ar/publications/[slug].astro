---
import type { CollectionEntry } from 'astro:content';
import ArticleDetail from '../../../components/ArticleDetail.astro';
import { getArticlePaths } from '../../../lib/articles';

const locale = 'ar' as const;
export async function getStaticPaths() {
  return getArticlePaths('publications', 'ar');
}
const { entry, body } = Astro.props as {
  entry: CollectionEntry<'publications'>;
  body: CollectionEntry<'articleBodies'>;
};
---
<ArticleDetail entry={entry} body={body} section="publications" locale={locale} />
