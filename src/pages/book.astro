---
import BaseLayout from '../components/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';

const locale = 'en' as const;
---
<BaseLayout title="Book — Jodie Wen" locale={locale} description="Research on the Middle East Policy of the United States (2009–2017), a monograph by Dr. Jodie Wen.">
  <div class="mx-auto w-full max-w-6xl px-6 py-16 md:py-24">
  <SectionHeader as="h1" title="The Book" />
  <div class="grid max-w-[900px] gap-8 sm:grid-cols-[auto_1fr] sm:items-center sm:gap-14">
    <input type="checkbox" id="cover-zoom" class="peer sr-only" />
    <label for="cover-zoom" class="w-fit shrink-0 cursor-zoom-in rounded-lg peer-focus-visible:ring-2 peer-focus-visible:ring-accent">
      <img src="/images/book-cover.jpg" alt="Cover of Research on the Middle East Policy of the United States (2009–2017)" class="h-[280px] w-auto rounded-lg shadow-[0_20px_40px_-20px_rgb(23_23_23/0.28)] sm:h-[340px]" />
    </label>
    <div>
      <h3 class="font-serif text-2xl font-semibold">Research on the Middle East Policy of the United States (2009–2017)</h3>
      <p class="mt-1 text-neutral-500">《美国的中东政策研究（2009-2017）》 · Chinese-language monograph · January 2026</p>
      <div class="measure mt-4 space-y-4 text-neutral-700">
        <p>Drawing on years of research and fieldwork across the Middle East, this book offers a systematic study of U.S. policy toward the region from 2009 to 2017, tracing its evolution, drivers, and impact on regional order.</p>
        <p>Dr. Wen is a Fellow at the Center for International Security and Strategy (CISS), Tsinghua University, specializing in U.S. foreign policy and Middle East politics.</p>
      </div>
      <div class="mt-6">
        <h4 class="text-sm font-semibold uppercase tracking-wide text-neutral-500">Publication</h4>
        <p class="mt-1 text-sm text-neutral-600">World Affairs Press (世界知识出版社) · January 2026 · ISBN 9787501269600 · <a href="https://product.dangdang.com/30001244.html" target="_blank" rel="noopener" class="text-accent hover:underline">Buy on Dangdang</a></p>
      </div>
    </div>
    <label for="cover-zoom" class="fixed inset-0 z-50 hidden cursor-zoom-out items-center justify-center bg-neutral-900/70 p-6 peer-checked:flex">
      <img src="/images/book-cover.jpg" alt="Cover of Research on the Middle East Policy of the United States (2009–2017), enlarged" class="max-h-[90vh] max-w-full rounded-lg object-contain" />
    </label>
  </div>
  </div>
</BaseLayout>
