---
import BaseLayout from '../../components/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';

const locale = 'zh' as const;
---
<BaseLayout title="著作 — 文晶" locale={locale} description="文晶专著《美国的中东政策研究（2009-2017）》。">
  <SectionHeader as="h1" title="著作" />
  <div class="flex flex-col gap-8 sm:flex-row sm:items-center" id="book-cover">
    <a href="#cover-zoom" class="w-fit shrink-0 cursor-zoom-in">
      <img src="/images/book-cover.jpg" alt="《美国的中东政策研究（2009-2017）》封面" class="h-96 w-auto rounded-md" />
    </a>
    <div>
      <h3 class="font-serif text-2xl font-semibold">《美国的中东政策研究（2009-2017）》</h3>
      <p class="mt-1 text-neutral-500">学术专著 · 2026 年 1 月出版</p>
      <div class="measure mt-4 space-y-4 text-neutral-700">
        <p>本书基于作者多年研究与在中东地区的田野调查，系统梳理 2009 至 2017 年间美国中东政策的演变脉络、内在动因及其对地区秩序的影响。</p>
        <p>作者文晶为清华大学战略与安全研究中心研究员，主要研究领域为美国外交与中东政治。</p>
      </div>
      <div class="mt-6">
        <h4 class="text-sm font-semibold uppercase tracking-wide text-neutral-500">出版信息</h4>
        <p class="mt-1 text-sm text-neutral-600">世界知识出版社 · 2026 年 1 月 · ISBN 9787501269600 · <a href="https://product.dangdang.com/30001244.html" target="_blank" rel="noopener" class="text-accent hover:underline">当当网购买</a></p>
      </div>
    </div>
  </div>
  <div id="cover-zoom" class="fixed inset-0 z-50 hidden items-center justify-center bg-neutral-900/70 p-6 target:flex">
    <a href="#book-cover" class="absolute inset-0 cursor-zoom-out" aria-label="关闭放大封面"></a>
    <a href="#book-cover" class="relative cursor-zoom-out">
      <img src="/images/book-cover.jpg" alt="《美国的中东政策研究（2009-2017）》封面（放大）" class="max-h-[90vh] max-w-full rounded-md object-contain" />
    </a>
  </div>
</BaseLayout>
