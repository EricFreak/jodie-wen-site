---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import MediaBrowser from '../../components/MediaBrowser.astro';
import { ui } from '../../i18n/ui';

const locale = 'zh' as const;
const t = ui[locale];
const all = (await getCollection('media'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const videos = all.filter((e) => e.data.type === 'video');
const interviews = all.filter((e) => e.data.type === 'interview');
const mentions = all.filter((e) => e.data.type === 'mention');
---
<BaseLayout title="媒体 — 文晶" locale={locale} description="文晶的媒体采访、视频与引用报道。">
  <SectionHeader as="h1" title={t['media.title']} />
  <MediaBrowser videos={videos} interviews={interviews} mentions={mentions} locale={locale} />
</BaseLayout>
