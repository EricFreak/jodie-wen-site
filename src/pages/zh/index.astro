---
import { getCollection } from 'astro:content';
import PublicationList from '../../components/PublicationList.astro';
import BaseLayout from '../../components/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import VideoCard from '../../components/VideoCard.astro';
import Gallery from '../../components/Gallery.astro';
import ActivityCarousel from '../../components/ActivityCarousel.astro';
import { ui } from '../../i18n/ui';
import { localizePath } from '../../i18n/utils';

const locale = 'zh' as const;
const t = ui[locale];
const latest = (await getCollection('publications'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
// 首页视频卡片：featured 优先，其余按日期倒序，取前 3 条
const videos = (await getCollection('media'))
  .filter((e) => e.data.type === 'video')
  .sort((a, b) => Number(b.data.featured ?? false) - Number(a.data.featured ?? false) || b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const photos = (await getCollection('gallery'))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
// 首页活动轮播：仅展示有封面图的活动，按日期倒序，最多 5 张，超出显示 View all
const activities = (await getCollection('activities'))
  .filter((e) => e.data.cover)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const activitySlides = activities.slice(0, 5);
---
<BaseLayout title="文晶 — 清华大学战略与安全研究中心研究员" locale={locale} description={t['hero.tagline']}>
  <Hero locale={locale} />

  <section class="mx-auto w-full max-w-6xl px-6 py-16 md:py-24">
    <SectionHeader title={t['home.book.title']} />
    <div class="grid max-w-[900px] gap-8 sm:grid-cols-[auto_1fr] sm:items-center sm:gap-14">
      <input type="checkbox" id="cover-zoom" class="peer sr-only" />
      <label for="cover-zoom" class="w-fit shrink-0 cursor-zoom-in rounded-lg peer-focus-visible:ring-2 peer-focus-visible:ring-accent">
        <img src="/images/book-cover.jpg" alt="《美国的中东政策研究（2009-2017）》封面" class="h-[280px] w-auto rounded-lg shadow-[0_20px_40px_-20px_rgb(23_23_23/0.28)] sm:h-[340px]" />
      </label>
      <div>
        <h3 class="font-serif text-2xl font-semibold">《美国的中东政策研究（2009-2017）》</h3>
        <p class="mt-2.5 text-sm text-neutral-500">2026 年 1 月出版</p>
        <p class="measure mt-4 text-neutral-700">本书系统研究 2009 至 2017 年间美国的中东政策，基于作者长期的研究积累与在中东地区的田野调查。</p>
        <a href={localizePath('/book', locale)} class="mt-7 inline-block text-sm font-medium text-accent hover:underline">{t['home.viewAll']}</a>
      </div>
      <label for="cover-zoom" class="fixed inset-0 z-50 hidden cursor-zoom-out items-center justify-center bg-neutral-900/70 p-6 peer-checked:flex">
        <img src="/images/book-cover.jpg" alt="《美国的中东政策研究（2009-2017）》封面（放大）" class="max-h-[90vh] max-w-full rounded-lg object-contain" />
      </label>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-6 py-16 md:py-24">
    <SectionHeader title={t['home.publications.title']} />
    <PublicationList entries={latest} locale={locale} flat />
    <a href={localizePath('/publications', locale)} class="mt-7 inline-block text-sm font-medium text-accent hover:underline">{t['home.viewAll']}</a>
  </section>

  <section class="mx-auto w-full max-w-6xl px-6 py-16 md:py-24">
    <SectionHeader title={t['home.media.title']} />
    {videos.length > 0 && (
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {videos.map((v) => <VideoCard entry={v} locale={locale} />)}
      </div>
    )}
    <a href={localizePath('/media', locale)} class="mt-7 inline-block text-sm font-medium text-accent hover:underline">{t['home.viewAll']}</a>
  </section>

  {activitySlides.length > 0 && (
    <section class="border-y border-neutral-200 bg-neutral-50">
      <div class="mx-auto w-full max-w-6xl px-6 py-16 md:py-24">
        <div class="flex items-end justify-between gap-6">
          <SectionHeader title={t['home.activities.title']} subtitle={t['home.activities.subtitle']} />
          <a href={localizePath('/activities', locale)} class="mb-12 shrink-0 text-sm font-medium text-accent hover:underline">{t['home.viewAll']}</a>
        </div>
        <ActivityCarousel entries={activitySlides} locale={locale} />
      </div>
    </section>
  )}

  <section class="mx-auto w-full max-w-6xl px-6 py-16 md:py-24">
    <SectionHeader title={t['home.moreAbout']} />
    {photos.length === 0
      ? <p class="text-neutral-500">{t['empty']}</p>
      : <Gallery entries={photos} locale={locale} />}
  </section>
</BaseLayout>
