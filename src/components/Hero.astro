---
import { ui, type Locale } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import SocialIcon from './SocialIcon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const name = locale === 'zh' ? '文晶' : locale === 'ar' ? 'جودي ون' : 'Jodie Wen';
const portraitAlt = locale === 'zh' ? '文晶肖像' : locale === 'ar' ? 'صورة جودي ون' : 'Portrait of Dr. Jodie Wen';

const credentials =
  locale === 'zh'
    ? ['北京大学中东研究博士', '牛津大学访问学者', '清华大学法学博士后', '资深媒体人']
    : locale === 'ar'
      ? ['دكتوراه في دراسات الشرق الأوسط (جامعة بكين)', 'باحثة زائرة بجامعة أكسفورد', 'باحثة ما بعد الدكتوراه في القانون (تسينغهوا)', 'إعلامية مخضرمة']
      : ['Ph.D. in Middle East Studies, PKU', 'Oxford Visiting Scholar', 'Postdoc in Law, Tsinghua', 'Former Senior Journalist'];
// Hero 社媒圆点：点击进入本站 Social Media 页
const icons = ['wechat', 'x', 'linkedin'] as const;
---
<section class="border-b border-neutral-200 bg-neutral-50">
  <div class="mx-auto grid w-full max-w-6xl grid-cols-1 items-center gap-10 px-6 py-14 md:grid-cols-[1.25fr_1fr] md:gap-20 md:py-24">
    <div class="order-2 md:order-1">
      <p class="text-[15px] font-semibold text-accent">{t['hero.kicker']}</p>
      <h1 class="mt-4 font-serif text-4xl leading-[1.05] font-bold tracking-tight md:text-[64px]">{name}</h1>
      <p class="mt-5 max-w-[30ch] text-[17px] text-neutral-600 md:text-xl">{t['hero.tagline']}</p>
      <p class="measure mt-4 text-base text-neutral-600">{t['hero.bio']}</p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {credentials.map((c) => <li class="rounded-md border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-600">{c}</li>)}
      </ul>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href={localizePath('/book', locale)} class="rounded-lg bg-accent px-6 py-3 text-[15px] font-medium text-white transition-opacity hover:opacity-90">{t['hero.cta.book']}</a>
        <a href={localizePath('/contact', locale)} class="rounded-lg border border-accent px-6 py-3 text-[15px] font-medium text-accent transition-opacity hover:opacity-80">{t['contactband.title']}</a>
        <span class="ms-2 inline-flex items-center gap-2">
          {icons.map((icon) => (
            <a
              href={localizePath('/social', locale)}
              aria-label={icon}
              class="flex h-10 w-10 items-center justify-center rounded-full border border-neutral-200 text-neutral-600 transition hover:border-accent hover:text-accent"
            >
              <SocialIcon name={icon} class="h-[18px] w-[18px]" />
            </a>
          ))}
        </span>
      </div>
    </div>
    <div class="order-1 md:order-2">
      <img src="/images/portrait.jpg" alt={portraitAlt} class="w-full max-w-[280px] rounded-lg shadow-[0_24px_48px_-24px_rgb(23_23_23/0.25)] md:ms-auto md:max-w-[420px]" />
    </div>
  </div>
</section>
