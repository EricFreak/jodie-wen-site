---
import { ui, type Locale } from '../i18n/ui';
import { fillTemplate } from '../i18n/utils';

interface Props {
  locale: Locale;
  title: string;
  kicker: string;
  cover?: string;
  coverCredit?: string;
  sourceUrl?: string;
  sourceName: string;
  dateLabel: string;
  sourceLang: 'en' | 'zh' | 'ar';
  backHref: string;
  backLabel: string;
}
const {
  locale,
  title,
  kicker,
  cover,
  coverCredit,
  sourceUrl,
  sourceName,
  dateLabel,
  sourceLang,
  backHref,
  backLabel,
} = Astro.props;
const t = ui[locale];
const langNames: Record<'en' | 'zh' | 'ar', string> = {
  en: t['article.lang.en'],
  zh: t['article.lang.zh'],
  ar: t['article.lang.ar'],
};
const isTranslated = locale !== sourceLang;
const sourceNote = fillTemplate(t['article.sourceNote'], { source: sourceName, date: dateLabel });
const translationNote = isTranslated
  ? fillTemplate(t['article.translationNote'], { lang: langNames[sourceLang] })
  : null;
const backArrow = locale === 'ar' ? '→' : '←';
const readArrow = locale === 'ar' ? '←' : '→';
---
<article class="mx-auto w-full max-w-4xl px-6 py-16 md:py-24">
  <a href={backHref} class="text-sm text-accent hover:underline">
    <span aria-hidden="true">{backArrow}</span> {backLabel}
  </a>

  <p class="mt-10 text-sm text-neutral-500">{kicker}</p>
  <h1 class="mt-4 font-serif text-4xl leading-tight font-semibold text-neutral-900 md:text-5xl">{title}</h1>

  {cover && (
    <figure class="mt-10">
      <img src={cover} alt={title} class="aspect-video w-full rounded-lg object-cover" />
      {coverCredit && <figcaption class="mt-2 text-xs text-neutral-500">{coverCredit}</figcaption>}
    </figure>
  )}

  {translationNote && <p class="mt-6 text-xs text-neutral-500">{translationNote}</p>}

  <div class="article-body mt-10 w-full leading-8 text-neutral-700">
    <slot />
  </div>

  <footer class="mt-14 border-t border-neutral-200 pt-6">
    <p class="text-sm text-neutral-500">{sourceNote}</p>
    {sourceUrl && (
      <a href={sourceUrl} target="_blank" rel="noopener" class="mt-3 inline-block text-sm font-medium text-accent hover:underline">
        {t['article.readOriginal']} <span aria-hidden="true">{readArrow}</span>
      </a>
    )}
  </footer>
</article>
