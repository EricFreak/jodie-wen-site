---
import { ui, type Locale } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import SocialIcon from './SocialIcon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const year = new Date().getFullYear();
// 页脚社媒图标：点击进入本站 Social Media 页
const icons = ['wechat', 'channels', 'bilibili', 'youtube', 'x', 'linkedin'] as const;
---
<footer class="mt-16 border-t border-neutral-200">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-4 px-4 py-8 text-sm text-neutral-500 md:flex-row md:justify-between">
    <p>© {year} {locale === 'zh' ? '文晶' : locale === 'ar' ? 'جودي ون' : 'Jodie Wen'}. {t['footer.rights']}</p>
    <div class="flex items-center gap-3">
      {icons.map((name) => (
        <a
          href={localizePath('/social', locale)}
          aria-label={name}
          class="flex h-9 w-9 items-center justify-center rounded-full border border-neutral-200 text-neutral-600 hover:border-accent hover:text-accent"
        >
          <SocialIcon name={name} class="h-[18px] w-[18px]" />
        </a>
      ))}
    </div>
    <p>
      <a href="mailto:jodiewen@tsinghua.edu.cn" class="text-accent hover:underline">jodiewen@tsinghua.edu.cn</a>
    </p>
  </div>
</footer>
