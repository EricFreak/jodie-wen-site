---
import { ui, type Locale } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import SocialIcon from './SocialIcon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const year = new Date().getFullYear();
const name = locale === 'zh' ? '文晶' : locale === 'ar' ? 'جودي ون' : 'Jodie Wen';

const items = [
  { path: '/', label: t['nav.home'] },
  { path: '/about', label: t['nav.about'] },
  { path: '/book', label: t['nav.book'] },
  { path: '/publications', label: t['nav.publications'] },
  { path: '/media', label: t['nav.media'] },
  { path: '/activities', label: t['nav.activities'] },
  { path: '/social', label: t['nav.social'] },
  { path: '/contact', label: t['nav.contact'] },
];
// 页脚社媒图标：点击进入本站 Social Media 页
const icons = ['wechat', 'weibo', 'x', 'linkedin'] as const;
---
<footer class="bg-neutral-900 text-neutral-400">
  <div class="mx-auto flex w-full max-w-6xl flex-col items-center gap-6 px-6 py-14">
    <a href={localizePath('/', locale)} aria-label="Home">
      <img src="/images/brand/logo-mark.png" alt="" class="h-10 w-auto opacity-90" />
    </a>
    <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
      {items.map((item) => (
        <li>
          <a href={localizePath(item.path, locale)} class="text-[13.5px] hover:text-white">{item.label}</a>
        </li>
      ))}
    </ul>
    <div class="flex items-center gap-3">
      {icons.map((name) => (
        <a
          href={localizePath('/social', locale)}
          aria-label={name}
          class="flex h-10 w-10 items-center justify-center rounded-full border border-neutral-700 text-neutral-400 transition hover:border-white hover:text-white"
        >
          <SocialIcon name={name} class="h-[18px] w-[18px]" />
        </a>
      ))}
    </div>
    <p class="text-[13px] text-neutral-500">© {year} {name}. {t['footer.rights']}</p>
  </div>
</footer>
