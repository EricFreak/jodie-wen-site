---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/ui';
import { localizePath } from '../i18n/utils';

// detail 条目进站内详情；url 以 / 开头的旧式站内链接也本地化；其余外链。
const activityHref = (e: CollectionEntry<'activities'>, locale: Locale) => {
  if (e.data.detail) return localizePath(`/activities/${e.id}/`, locale);
  if (!e.data.url) return undefined;
  return e.data.url.startsWith('/') ? localizePath(e.data.url, locale) : e.data.url;
};
const activityExternal = (e: CollectionEntry<'activities'>) =>
  !e.data.detail && !!e.data.url && !e.data.url.startsWith('/');

interface Props {
  entries: CollectionEntry<'activities'>[];
  locale: Locale;
}
const { entries, locale } = Astro.props;
const fmt = (dt: Date) => dt.toISOString().slice(0, 10);
const radioId = (i: number) => `activity-radio-${i}`;
// 纯 CSS 轮播：radio + label 切换幻灯片，不用锚点跳转，点击箭头/圆点页面位置不变
// 类名须完整出现以便 Tailwind 扫描；幻灯片上限 5 张（调用方 slice(0, 5)）
const peers = ['peer/slide0', 'peer/slide1', 'peer/slide2', 'peer/slide3', 'peer/slide4'];
const visible = [
  'peer-checked/slide0:block',
  'peer-checked/slide1:block',
  'peer-checked/slide2:block',
  'peer-checked/slide3:block',
  'peer-checked/slide4:block',
];
---
<div>
  {entries.map((_, i) => (
    // fixed 定位的隐藏 input：label 点击使其获焦时浏览器不会滚动页面
    <input type="radio" name="activity-carousel" id={radioId(i)} checked={i === 0} class:list={[peers[i], 'pointer-events-none fixed opacity-0']} />
  ))}
  {entries.map((e, i) => {
    const d = e.data;
    const href = activityHref(e, locale);
    const external = activityExternal(e);
    return (
      <div class:list={['hidden', visible[i]]}>
        <div class="relative">
          {href ? (
            <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined} class="group block aspect-video overflow-hidden rounded-lg">
              <img src={d.cover} alt="" loading={i === 0 ? 'eager' : 'lazy'} class="h-full w-full object-cover" />
            </a>
          ) : (
            <div class="aspect-video overflow-hidden rounded-lg">
              <img src={d.cover} alt="" loading={i === 0 ? 'eager' : 'lazy'} class="h-full w-full object-cover" />
            </div>
          )}
          {i > 0 && (
            <label for={radioId(i - 1)} aria-label="Previous activity" class="absolute start-3 top-1/2 flex h-9 w-9 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-white/90 text-neutral-800 shadow transition hover:bg-white">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 rtl:-scale-x-100"><path d="M15 5l-7 7 7 7" /></svg>
            </label>
          )}
          {i < entries.length - 1 && (
            <label for={radioId(i + 1)} aria-label="Next activity" class="absolute end-3 top-1/2 flex h-9 w-9 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-white/90 text-neutral-800 shadow transition hover:bg-white">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 rtl:-scale-x-100"><path d="M9 5l7 7-7 7" /></svg>
            </label>
          )}
        </div>
      </div>
    );
  })}
  {entries.length > 1 && (
    <div class="activity-dots mt-3 flex items-center justify-center gap-2">
      {entries.map((_, i) => (
        <label for={radioId(i)} aria-label={`Go to activity ${i + 1}`} class="activity-dot h-2 w-2 cursor-pointer rounded-full transition" />
      ))}
    </div>
  )}
  {entries.map((e, i) => {
    const d = e.data;
    const title = locale === 'zh' ? d.titleZh : locale === 'ar' ? (d.titleAr ?? d.titleEn) : d.titleEn;
    const location = locale === 'zh' ? d.locationZh : locale === 'ar' ? (d.locationAr ?? d.location) : d.location;
    const href = activityHref(e, locale);
    const external = activityExternal(e);
    return (
      <div class:list={['hidden', visible[i]]}>
        {href ? (
          <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined} class="mt-3 block min-h-11 line-clamp-2 text-sm leading-snug font-medium text-neutral-800 hover:text-accent sm:text-base"><bdi>{title}</bdi></a>
        ) : (
          <p class="mt-3 min-h-11 line-clamp-2 text-sm leading-snug font-medium text-neutral-800 sm:text-base"><bdi>{title}</bdi></p>
        )}
        <p class="mt-1 text-xs text-neutral-500"><bdi>{location}</bdi> · <bdi dir="ltr">{fmt(d.date)}</bdi></p>
      </div>
    );
  })}
</div>

<style>
  /* 圆点嵌套在 .activity-dots 内、与 input 不是同级，Tailwind peer(~ 兄弟选择器)覆盖不到，故用原生 CSS 做当前页高亮 */
  .activity-dot {
    background-color: var(--color-neutral-300);
  }
  #activity-radio-0:checked ~ .activity-dots label[for='activity-radio-0'],
  #activity-radio-1:checked ~ .activity-dots label[for='activity-radio-1'],
  #activity-radio-2:checked ~ .activity-dots label[for='activity-radio-2'],
  #activity-radio-3:checked ~ .activity-dots label[for='activity-radio-3'],
  #activity-radio-4:checked ~ .activity-dots label[for='activity-radio-4'] {
    background-color: var(--color-accent);
  }
</style>
