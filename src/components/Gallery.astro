---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/ui';

interface Props {
  entries: CollectionEntry<'gallery'>[];
  locale: Locale;
}
const { entries, locale } = Astro.props;
const caption = (e: CollectionEntry<'gallery'>) =>
  locale === 'zh' ? e.data.captionZh : locale === 'ar' ? e.data.captionAr : e.data.captionEn;
---
<div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
  {entries.map((e) => (
    <figure>
      <img src={e.data.image} alt={caption(e)} loading="lazy" class="aspect-[4/3] w-full rounded-lg object-cover" />
      <figcaption class="mt-2 text-sm text-neutral-600">{caption(e)}</figcaption>
    </figure>
  ))}
</div>
