---
export interface Props {
  title: string;
  subtitle?: string;
  as?: 'h1' | 'h2';
}
const { title, subtitle, as = 'h2' } = Astro.props;
const Tag = as;
---
<div class="mb-8">
  <Tag class="font-serif text-3xl font-bold">{title}</Tag>
  {subtitle && <p class="mt-2 text-neutral-600">{subtitle}</p>}
  <div class="mt-3 h-0.5 w-12 bg-accent"></div>
</div>
