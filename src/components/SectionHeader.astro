---
interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---
<div class="mb-8">
  <h2 class="font-serif text-3xl font-bold">{title}</h2>
  {subtitle && <p class="mt-2 text-neutral-600">{subtitle}</p>}
  <div class="mt-3 h-0.5 w-12 bg-accent"></div>
</div>
