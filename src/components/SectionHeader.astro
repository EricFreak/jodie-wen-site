---
export interface Props {
  title: string;
  subtitle?: string;
  as?: 'h1' | 'h2';
}
const { title, subtitle, as = 'h2' } = Astro.props;
const Tag = as;
---
<div class="mb-12">
  <Tag class="font-serif text-3xl font-bold md:text-4xl">{title}</Tag>
  {subtitle && <p class="mt-2 text-neutral-600">{subtitle}</p>}
  <div class="mt-4 h-[3px] w-14 bg-accent"></div>
</div>
