---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/ui';
import { outletLabel } from '../data/outlets';

interface Props {
  entry: CollectionEntry<'media'>;
  locale: Locale;
}
const { entry, locale } = Astro.props;
const d = entry.data;
const title = locale === 'zh' ? d.titleZh : d.titleEn;
const fmt = (dt: Date) => dt.toISOString().slice(0, 10);
---
<div class="flex flex-wrap items-baseline gap-x-3 border-b border-neutral-100 py-2.5">
  <a href={d.url} target="_blank" rel="noopener" class="font-medium text-neutral-800 hover:text-accent">{title}</a>
  <span class="shrink-0 text-sm text-neutral-500">{outletLabel(d.outlet, locale)} · {fmt(d.date)}</span>
</div>
