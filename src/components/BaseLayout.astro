---
import '../styles/global.css';
import Nav from './Nav.astro';
import ContactBand from './ContactBand.astro';
import Footer from './Footer.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  title: string;
  locale: Locale;
  description?: string;
  /** Contact 页传 false：页面本身即联系方式，不再重复联系带 */
  showContactBand?: boolean;
}
const { title, locale, description, showContactBand = true } = Astro.props;
---
<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : locale} dir={locale === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/images/brand/favicon-32.png" />
    <link rel="apple-touch-icon" href="/images/brand/logo-mark-180.png" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col overflow-x-clip">
    <Nav locale={locale} currentPath={Astro.url.pathname} />
    <main class="w-full flex-1">
      <slot />
    </main>
    {showContactBand && <ContactBand locale={locale} />}
    <Footer locale={locale} />
  </body>
</html>
