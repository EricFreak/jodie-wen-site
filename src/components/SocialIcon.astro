  bilibili:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="%%CLS%%"><rect x="3" y="6.5" width="18" height="13" rx="3"/><path d="M7.5 2.5 10 6M16.5 2.5 14 6" stroke-linecap="round"/><path d="M8.5 12h.4M15.1 12h.4" stroke-linecap="round" stroke-width="2.6"/></svg>',
  youtube:
