    '<svg viewBox="0 0 24 24" fill="currentColor" class="%%CLS%%"><path d="M9.5 4C5.36 4 2 6.91 2 10.5c0 2.05 1.12 3.87 2.86 5.02L4.14 18l2.72-1.46c.83.26 1.72.4 2.64.4.18 0 .36-.01.54-.02-.11-.45-.17-.92-.17-1.42 0-3.32 3.13-6 7-6 .23 0 .46.01.68.03C16.9 6.24 13.5 4 9.5 4zM7 8.6a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8zm5 0a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8zM16.87 10.5c-3.31 0-6 2.24-6 5s2.69 5 6 5c.77 0 1.5-.12 2.18-.34L21.3 21l-.62-1.94A4.86 4.86 0 0 0 22.9 15.5c0-2.76-2.72-5-6.03-5zm-2.22 2.6a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5zm4.44 0a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5z"/></svg>',
  channels:
