    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="%%CLS%%"><ellipse cx="10.5" cy="13.5" rx="7.5" ry="5.5"/><circle cx="10.5" cy="13.5" r="2.2" fill="currentColor" stroke="none"/><path d="M17.5 4.5a4.5 4.5 0 0 1 4 4.5M17.8 7.4a2.3 2.3 0 0 1 2 2.3" stroke-linecap="round"/></svg>',
